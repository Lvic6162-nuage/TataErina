<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxury Oils - AICHA</title>
    <script src="https://telegram.org"></script>
    <style>
        body { font-family: Arial, sans-serif; background: #0a0a12; color: #e0e0ff; padding: 15px; text-align: center; }
        .produit { background: #121222; border: 1px solid #7928ca; padding: 18px; border-radius: 12px; box-shadow: 0 0 10px rgba(121,40,202,0.3); margin-bottom: 20px; text-align: left; }
        .prix { color: #00ffff; font-weight: bold; font-size: 24px; margin: 10px 0; text-shadow: 0 0 5px #00ffff; }
        .video { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; background: #000; border-radius: 8px; margin-bottom: 15px; }
        .video iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }
        label { display: block; margin: 10px 0 5px 0; font-size: 14px; color: #8888aa; text-transform: uppercase; }
        select { width: 100%; padding: 10px; background: #1a1a30; border: 1px solid #7928ca; color: white; border-radius: 6px; font-size: 15px; margin-bottom: 15px; outline: none; }
        .btn { background: linear-gradient(90deg, #0070f3, #00dfd8); color: white; border: none; padding: 14px; border-radius: 6px; font-size: 14px; font-weight: bold; width: 100%; cursor: pointer; text-transform: uppercase; }
        .btn-contact { background: linear-gradient(90deg, #7928ca, #ff0080); color: white; text-decoration: none; display: block; padding: 12px; border-radius: 6px; margin-top: 15px; font-weight: bold; text-align: center; text-transform: uppercase; }
    </style>
</head>
<body>

    <div class="produit">
        <div class="video">
            <!-- 🟡 DEPOSEZ VOTRE LIEN DE VIDEO ENTIER ENTRE LES GUILLEMETS CI-DESSOUS -->
            <iframe src="https://youtube.com" allowfullscreen></iframe>
        </div>
        <h3>⚡ COLLECTION AICHA</h3>
        <p style="color: #8888aa; font-size: 14px; margin: 0;">Sélectionnez votre parfum et votre taille :</p>

        <!-- 🔴 VOS 5 PARFUMS CONFIGURÉS ICI -->
        <label for="variete">Choisir la senteur :</label>
        <select id="variete">
            <option value="Aïcha #1">Aïcha #1 🌟</option>
            <option value="Aïcha #2">Aïcha #2 ✨</option>
            <option value="Aïcha #3">Aïcha #3 💎</option>
            <option value="Aïcha #4">Aïcha #4 🌙</option>
            <option value="Aïcha #5">Aïcha #5 👑</option>
        </select>

        <label for="taille">Choisir la taille :</label>
        <select id="taille" onchange="mettreAJourPrix()">
            <option value="1ml">1 ml</option>
            <option value="3ml">3 ml</option>
            <option value="5ml">5 ml</option>
            <option value="10ml">10 ml</option>
        </select>

        <div class="prix" id="affichage-prix">5,00 €</div>

        <button class="btn" onclick="lancerCommande()">⚡ INITIALIZE ORDER</button>
    </div>

    <div class="produit" style="text-align: center; border-color: #00ffff;">
        <h3>SECURE CHANNEL</h3>
        <!-- 🔴 METTEZ VOTRE PSEUDO EN TOUTES LETTRES SANS LE @ CI-DESSOUS -->
        <a href="https://t.me" class="btn-contact">🔗 OPEN SECURE CHAT</a>
    </div>

    <script>
        const tg = window.Telegram.WebApp; 
        tg.expand();

        // 🟢 VOS TARIFS PAR DÉFAUT (À modifier si vous le souhaitez)
        const tarifs = {
            "1ml": "5,00 €",
            "3ml": "10,00 €",
            "5ml": "15,00 €",
            "10ml": "20,00 €"
        };

        function mettreAJourPrix() {
            const tailleSelectionnee = document.getElementById('taille').value;
            document.getElementById('affichage-prix').innerText = tarifs[tailleSelectionnee];
        }

        function lancerCommande() {
            const variete = document.getElementById('variete').value;
            const taille = document.getElementById('taille').value;
            const prix = tarifs[taille];
            const msg = encodeURIComponent(`🚨 [COMMANDE PARFUM] :\n• Gamme : ${variete}\n• Volume : ${taille}\n• Montant : ${prix}\n• Livraison : Main propre.`);
            
            /* 🔴 METTEZ VOTRE PSEUDO EN TOUTES LETTRES SANS LE @ CI-DESSOUS */
            window.open(`https://t.me?text=${msg}`, '_blank');
        }
    </script>
</body>
</html>
